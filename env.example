# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# Часовой пояс для отображения времени и расчёта слотов
TIMEZONE=Asia/Tashkent

# Длительность слота (минуты)
SLOT_MINUTES=60

# Сколько минут даётся на подтверждение "+" когда подошла очередь
CONFIRM_MINUTES=5

# Путь к файлу базы данных SQLite
DB_PATH=queue_bot.db

# ID темы (ветки) в супергруппе, где бот должен ЕДИНСТВЕННО работать.
# Оставь пустым, если тем/веток нет или ограничение не нужно.
# Узнать id — отправь /threadid прямо в нужной ветке.
ALLOWED_THREAD_ID=
